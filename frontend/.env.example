# Copy this file to `.env.local` for local development.
# On Vercel, add the same variables under Project Settings -> Environment Variables.
#
# Everything prefixed NEXT_PUBLIC_ is bundled into the browser, so NEVER put secrets
# (JWT secret, database URI, Twilio token, Firebase private key) in this file.

# URL of the Express backend (no trailing slash, no /api suffix).
# Local:       http://localhost:5000
# Production:  https://your-service.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Socket.io server. Leave empty to reuse NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_SOCKET_URL=

# Show one-click demo logins (admin / doctor / patient) on the login page.
# Set to "false" (or remove) in production.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=true

# Firebase *web* config for push notifications. These identify your Firebase project
# and are designed to be public; restrict the API key by HTTP referrer in Google Cloud.
# Leave blank to disable push notifications.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDiLME602tfHakACW2u1RKxPvu57KgOLIs
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=clinic-34504.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=clinic-34504
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=clinic-34504.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=205865028471
NEXT_PUBLIC_FIREBASE_APP_ID=1:205865028471:web:a3a7c06284a498f7342f72
